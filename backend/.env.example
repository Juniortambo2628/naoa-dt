APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Public site serving guest invitations (invite emails, exports, CORS)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Off-site copies of the nightly backup (backups:create --offsite, see config/backups.php).
# BACKUP_OFFSITE_DISK: a disk name from config/filesystems.php (e.g. s3, ftp, sftp);
#   its credentials go in the disk's own env vars (AWS_* for s3). The zip is
#   uploaded to BACKUP_OFFSITE_PATH and pruned there to the same --keep count.
# BACKUP_OFFSITE_EMAIL: comma-separated recipients; the zip is attached unless
#   it is larger than BACKUP_OFFSITE_EMAIL_MAX_MB (then the email just says so).
# Leave empty to keep backups only in storage/app/backups.
BACKUP_OFFSITE_DISK=
BACKUP_OFFSITE_PATH=backups
BACKUP_OFFSITE_EMAIL=
BACKUP_OFFSITE_EMAIL_MAX_MB=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# M-Pesa cash gifts (Daraja "Lipa Na M-Pesa Online" STK Push) — see docs/mpesa-setup.md.
# Keys and passkey stay here on the server only, never in Admin settings.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# A long random string; it becomes part of the callback URL Safaricom calls.
MPESA_CALLBACK_TOKEN=
# Public https address of this API (defaults to APP_URL).
MPESA_CALLBACK_BASE_URL=
